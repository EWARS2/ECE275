library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity testbenchLab6 is
end;

architecture arch of testbenchLab6 is

    component Lab6 is
        port (
        A, B   : in  std_logic_vector(3 downto 0);
        Opcode : in  std_logic_vector(2 downto 0);
        F      : out std_logic_vector(3 downto 0);
        Cout, Z : out std_logic
    	);
    end component;

    signal A, B : std_logic_vector(3 downto 0);
    signal Opcode : std_logic_vector(2 downto 0);

    signal F : std_logic_vector(3 downto 0);
    signal Cout, Z : std_logic;

begin

    DUT: Lab6 port map(A, B, Opcode, F, Cout, Z);

    inputs: process
    begin

        for i in 0 to 15 loop
            for j in 0 to 15 loop

                A <= std_logic_vector(to_unsigned(i, A'length));
                B <= std_logic_vector(to_unsigned(j, B'length));

		Opcode <= "000";
                wait for 10 ns;
                assert unsigned(F) = i - 1
                    report "0 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "001";
                wait for 10 ns;
                assert unsigned(F) = i + 1
                    report "1 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "010";
                wait for 10 ns;
                assert unsigned(F) = not A
                    report "2 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "011";
                wait for 10 ns;
                assert unsigned(F) = A or B
                    report "3 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "100";
                wait for 10 ns;
                assert unsigned(F) = A xor B
                    report "4 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "101";
                wait for 10 ns;
                assert unsigned(F) = A and B
                    report "5 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "110";
                wait for 10 ns;
                assert unsigned(F) = i - j
                    report "6 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;

		Opcode <= "111";
                wait for 10 ns;
                assert unsigned(F) = i + j
                    report "7 Incorrect result: A=" & integer'image(i) &
                           " B=" & integer'image(j)
                    severity error;


            end loop;
        end loop;

        report "Tests finished" severity note;
        wait;

    end process;

end;