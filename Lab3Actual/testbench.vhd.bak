library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity testbench is
end;

architecture arch of testbench is
	component Lab3 is
		port(A, B, C, D: in std_logic;
			F1, F2, F3, F4: out std_logic);
	end component;

	signal A, B, C, D, F1, F2, F3, F4: std_logic;

begin
	DUT: Lab3 port map (A, B, C, D, F1, F2, F3, F4);
		inputs: process
			variable inputs : std_logic_vector(3 downto 0);
		begin

for i in 0 to 7 loop
	inputs := std_logic_vector(to_unsigned(i,3));
	A <= inputs(3);
	B <= inputs(2);
	C <= inputs(1);
	D <= inputs(0);
	wait for 10 ns;
end loop;
wait;
	end process;
end;


