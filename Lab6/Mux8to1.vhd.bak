library ieee;
use ieee.std_logic_1164.all;

entity Mux8to1 is
    port(S : in  std_logic_vector(2 downto 0);
			I : in  std_logic_vector(7 downto 0);
			F : out std_logic));
end;

architecture arch of Mux8to1 is
begin
	with S select
        F <= I(0) when "000",
             I(1) when "001",
             I(2) when "010",
             I(3) when "011",
             I(4) when "100",
             I(5) when "101",
             I(6) when "110",
             I(7) when "111",
             "0" when others;
end architecture;